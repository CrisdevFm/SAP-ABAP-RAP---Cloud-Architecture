@Metadata.layer: #INDUSTRY
@UI:{ headerInfo: { typeName: 'Customer',
                  typeNamePlural: 'Customers',
                  title : { type: #STANDARD, 
                           value: 'CustomerID' },
                  description:{ value: 'CustomerName' } } ,
                  presentationVariant: [{ sortOrder: [{ by: 'CustomerID',
                                                        direction: #ASC }],
                                                        visualizations: [{ type: #AS_LINEITEM }] }] }

//1. customer - Capa mas alta
//
//
//
//5. CORE - Capa mas baja

annotate entity Z_C_CUSTOMER_TRAVEL_883
    with 
{



    
@Consumption.valueHelpDefinition: [{ entity : { name: '/DMO/I_Customer_StdVH', 
                                                element: 'LastName' }, 
                                                useForValidation: true }] 
@UI:{ lineItem: [{ position: 10,
                   importance: #HIGH,
                   label: 'Customer ID' },
                 { type: #FOR_ACTION,
                   dataAction: 'acceptCustomer',
                   label: 'Accept Customer',
                   position: 10 },
                   { type: #FOR_ACTION,
                   dataAction: 'dejectCustomer',
                   label: 'Deject Customer',
                   position: 20 }],    
      selectionField: [{ position: 10 }],
      identification: [{ position: 10 },
                       { type: #FOR_ACTION,
                         dataAction: 'acceptCustomer',
                         label: 'Accept Customer',
                         position: 10 },
                       { type: #FOR_ACTION,
                         dataAction: 'dejectCustomer',
                         label: 'Deject Customer',
                         position: 20 }],
      textArrangement: #TEXT_FIRST }   
@UI.facet: [{ id:'CustomerDetails', 
              purpose: #STANDARD, 
              position: 10, 
              label: 'Customer Details', 
              type: #IDENTIFICATION_REFERENCE }]         
    CustomerID;
    
@UI:{ lineItem: [{ position: 20, 
                 importance: #HIGH, 
                 label: 'Customer Name' }],       
      identification: [{ position: 20 }]}
    CustomerName;   

@UI:{ lineItem: [{ position: 30, 
                 importance: #HIGH, 
                 label: 'Customer Country' }],       
      identification: [{ position: 30 }]} 
    CustomerCountry;
    
@UI:{ lineItem: [{ position: 40, 
                   importance: #HIGH, 
                   label: 'Description'  }] , 
      hidden: true  ,     
      identification: [{ position: 40 }]}    
    Description;
        
}